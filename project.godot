; Hollowfold — I-003 deterministic simulation. Open with Godot 4.7.2 stable.
config_version=5

[application]
config/name="Hollowfold"
config/version="0.3.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/auto_accept_quit=false
config/quit_on_go_back=false

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.047, 0.063, 0.071, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true

[debug]
gdscript/warnings/untyped_declaration=1
